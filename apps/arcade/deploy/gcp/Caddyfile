{
    admin off
}
fitness.integ.life {
    root * /opt/fitness-arcade/current/client
    encode zstd gzip
    # The gateway bounds video bodies at 200 MB and logs rejected attempts.
    # Keep the earlier limit for the separate legacy studio and all other routes.
    @boundedRequests {
        not {
            method PUT
            path_regexp galleryVideo ^/api/clips/[0-9a-f-]{36}$
        }
    }
    request_body @boundedRequests {
        max_size 20971520
    }
    # Keep existing unlisted clips, their management API and original studio.
    @legacyMedia path_regexp legacyMedia ^/(s|media|poster)/[0-9a-f]{32}$
    handle @legacyMedia {
        reverse_proxy 127.0.0.1:8410
    }
    @legacyAPI path_regexp legacyAPI ^/api/clips/[0-9a-f]{32}$
    handle @legacyAPI {
        reverse_proxy 127.0.0.1:8410
    }
    @legacyUpload {
        method POST
        path /api/clips
    }
    handle @legacyUpload {
        reverse_proxy 127.0.0.1:8410
    }
    handle /highlights {
        rewrite * /
        reverse_proxy 127.0.0.1:8410
    }
    @legacyAssets path /studio.js /view.js /style.css
    handle @legacyAssets {
        reverse_proxy 127.0.0.1:8410
    }
    @gateway path /api/* /healthz
    handle @gateway {
        reverse_proxy 127.0.0.1:8411
    }
    handle {
        @runtime path_regexp runtime ^/games/([^/]+)/runtime/(.+)$
        rewrite @runtime /runtime/{re.runtime.2}
        @pages path_regexp pages ^/(admin/games|play/[^/]+|gallery|library|shared|clips/[^/]+)/?$
        rewrite @pages /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
