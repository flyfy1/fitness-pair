[Unit]
Description=Hopmodo arcade API gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fitness-arcade
Group=fitness-arcade
WorkingDirectory=/opt/fitness-arcade/current
EnvironmentFile=-/etc/fitness-arcade.env
Environment=FITNESS_STATE_DIR=/var/lib/fitness-arcade
StateDirectory=fitness-arcade
StateDirectoryMode=0700
ExecStart=/usr/bin/node /opt/fitness-arcade/current/apps/arcade/deploy/gcp/gateway.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
