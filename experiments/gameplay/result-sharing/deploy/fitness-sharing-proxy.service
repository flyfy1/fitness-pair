[Unit]
Description=Fitness Pair dedicated HTTPS proxy
After=network-online.target fitness-sharing.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/fitness-sharing-proxy
Environment=XDG_CONFIG_HOME=/var/lib/fitness-sharing-proxy
ExecStart=/usr/bin/caddy run --config /etc/fitness-sharing.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=fitness-sharing-proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
